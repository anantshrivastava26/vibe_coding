# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node / backend
backend/node_modules/

# Secrets / environment / service credentials
.env
.env.*
backend/.env
backend/.env.*
# Note: android/app/google-services.json is intentionally NOT ignored — it ships
# inside every distributed APK and is required to build the app from a clone.
# The Admin SDK private key below is the actual secret and must never be committed.
**/serviceAccountKey.json
**/firebase-service-account*.json
**/*firebase-adminsdk*.json
